# eslint-plugin-react@7.37.5 declares peer deps up to eslint ^9.7 and has not
# yet released a version that adds ^10 to the range — despite working correctly
# with ESLint 10 at runtime.  legacy-peer-deps lets npm install proceed without
# an ERESOLVE error until the plugin publishes an updated peer dep declaration.
# Remove this file once eslint-plugin-react ships ESLint 10 peer dep support.
legacy-peer-deps=true
