{
  "name": "keypunch-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 verification harness: mock z/OS FTP/JES server + unit/integration tests. Runs on modern Node, decoupled from the app's Node-10 build.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "node start-mock.js",
    "smoke": "node launch-smoke.js",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "promise-ftp": "^1.3.2",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
