{
  "name": "keypunch-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Phase 0 verification harness: mock z/OS FTP/JES server + unit/integration tests. Runs on modern Node, decoupled from the app's Node-10 build.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mock": "tsx start-mock.ts",
    "smoke": "tsx launch-smoke.ts",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "basic-ftp": "^6.0.2"
  }
}
