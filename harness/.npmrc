# React and react-dom are peer dependencies of @testing-library/react, but we
# intentionally do NOT install them in harness/node_modules/.  Instead they
# resolve from the project root's node_modules/ (which contains react@18 +
# react-dom@18 + react-redux etc.), ensuring a single module instance.
#
# Without this flag, npm 7+ auto-installs peer deps, creating a duplicate
# react copy at harness/node_modules/react that disagrees with the copy used
# by react-redux (in the project root), causing "Invalid hook call" errors.
legacy-peer-deps=true
