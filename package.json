{
  "name": "keypunch",
  "productName": "Keypunch",
  "version": "0.1.0",
  "description": "Lightweight text editor designed to accelerate the ease of learning core IBM Mainframe languages like COBOL, PL/I, or z/Architecture Assembler by providing a dynamic hot reloading experience similar to Code School or Codecademy.",
  "type": "module",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "electron-vite build && electron-builder --publish never",
    "package-mac": "electron-vite build && electron-builder --mac",
    "package-win": "electron-vite build && electron-builder --win --x64",
    "package-linux": "electron-vite build && electron-builder --linux",
    "package-all": "electron-vite build && electron-builder -mwl"
  },
  "build": {
    "productName": "Keypunch",
    "appId": "com.bushidocodes.keypunch",
    "category": "public.app-category.tools",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "mac": {
      "icon": "resources/icons/1024x1024.png"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "resources/icons",
      "target": [
        "deb",
        "AppImage"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bushidocodes/keypunch.git"
  },
  "author": {
    "name": "Sean P. McBride",
    "email": "spmcbride1201@gmail.com",
    "url": "https://github.com/spmcbride1201"
  },
  "packageManager": "pnpm@11.5.0",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bushidocodes/keypunch/issues"
  },
  "keywords": [
    "mainframe"
  ],
  "homepage": "https://github.com/bushidocodes/keypunch#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jiti": "^2.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "ace-builds": "^1.43.0",
    "basic-ftp": "^6.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.17.0"
  }
}
